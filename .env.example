APP_NAME=Ekaadh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production (Coolify): APP_ENV=production, APP_DEBUG=false, APP_URL=https://YOUR_DOMAIN
# Generate once: php artisan key:generate --show
# First deploy only (Coolify terminal): php artisan migrate --force && php artisan db:seed --force
# Do not re-seed on every deploy. See DEPLOY.md.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ekaadh
DB_USERNAME=root
DB_PASSWORD=

# mock | zaad | edahab  (zaad/edahab need credentials; mock for MVP)
PAYMENT_GATEWAY=mock
DEFAULT_COMMISSION_RATE=10
SERVICE_FEE=1

# Optional dedicated QR HMAC secret (falls back to APP_KEY)
# Production: set a long random value and keep it stable after tickets exist.
TICKET_QR_SECRET=

# Fixed OTP for local/testing without SMS. Leave blank for random codes + TextBee.
OTP_FIXED_CODE=
OTP_TTL_SECONDS=600
OTP_SMS_MESSAGE="Your Ekaadh code is :code. Valid for :minutes minutes."

TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_TIMEOUT=20

# Comma-separated origins, or * for development
# Production: https://YOUR_DOMAIN
CORS_ALLOWED_ORIGINS=*

# Sanctum personal access token lifetime (minutes). Default 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

ZAAD_ENABLED=false
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
ZAAD_API_URL=

EDAHAB_ENABLED=false
EDAHAB_MERCHANT_ID=
EDAHAB_API_KEY=
EDAHAB_API_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ekaadh.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
