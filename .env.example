APP_NAME=Ekaadh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production (Coolify): APP_ENV=production, APP_DEBUG=false, APP_URL=https://YOUR_DOMAIN
# Generate once: php artisan key:generate --show
# First deploy only (Coolify terminal): php artisan migrate --force && php artisan db:seed --force
# Do not re-seed on every deploy. See DEPLOY.md.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ekaadh
DB_USERNAME=root
DB_PASSWORD=

# mock | waafipay | zaad | edahab
PAYMENT_GATEWAY=waafipay
PAYMENT_ALLOW_MOCK=false
PAYMENT_PENDING_TTL_MINUTES=30
DEFAULT_COMMISSION_RATE=10
SERVICE_FEE=1

# WaafiPay Purchase API (https://docs.waafipay.com/purchase-api)
# Switch with WAAFIPAY_MODE only — do not edit PHP. sandbox | live
# Sandbox needs its own merchant keys (live keys fail with "Authentication failed").
WAAFIPAY_MODE=sandbox

WAAFIPAY_SANDBOX_URL=https://sandbox.waafipay.com/asm
WAAFIPAY_SANDBOX_MERCHANT_UID=
WAAFIPAY_SANDBOX_API_USER_ID=
WAAFIPAY_SANDBOX_API_KEY=

WAAFIPAY_LIVE_URL=https://api.waafipay.net/asm
WAAFIPAY_LIVE_MERCHANT_UID=
WAAFIPAY_LIVE_API_USER_ID=
WAAFIPAY_LIVE_API_KEY=

WAAFIPAY_CURRENCY=USD
WAAFIPAY_TIMEOUT=45
WAAFIPAY_CHANNEL=WEB
# Windows/XAMPP local: path to CA bundle if cURL error 60 (SSL). Leave empty on Linux.
WAAFIPAY_CAFILE=

# Optional dedicated QR HMAC secret (falls back to APP_KEY locally).
# Production: required — set a long random value and keep it stable after tickets exist.
TICKET_QR_SECRET=

# Fixed OTP for local/testing without SMS. Leave blank for random codes + Telesom.
OTP_FIXED_CODE=
# Set true only on staging without SMS (exposes OTP in API JSON). Prefer OTP_FIXED_CODE for local.
OTP_EXPOSE_DEBUG_CODE=false
OTP_TTL_SECONDS=600
OTP_SMS_MESSAGE="Your Ekaadh code is :code. Valid for :minutes minutes."

# Telesom Prepaid SMS Gateway
# Auth: X-Auth-Key = Base64(HMAC-SHA256(SenderID + Timestamp + Username + Password))
# HMAC key = TELESOM_SECRET_KEY (falls back to TELESOM_PASSWORD). Timestamp is YYYY-MM-DD.
TELESOM_BASE_URL=https://sms.mytelesom.com
TELESOM_SENDER_ID=
TELESOM_USERNAME=
TELESOM_PASSWORD=
TELESOM_SECRET_KEY=
TELESOM_CLIENT_REF=
TELESOM_CALLBACK_URL=
TELESOM_TIMEOUT=20
TELESOM_CAFILE=

# Meta WhatsApp Cloud API (ticket + invitation delivery). Leave empty until templates approved.
# See DEPLOY.md "WhatsApp Cloud API".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TIMEOUT=20
WHATSAPP_TEMPLATE_TICKET=ekaadh_ticket_ready
WHATSAPP_TEMPLATE_INVITE=ekaadh_invitation
WHATSAPP_TEMPLATE_LANG=en

# Production first seed only:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PHONE=

# Comma-separated origins, or * for local/dev only.
# Production: CORS_ALLOWED_ORIGINS=https://ekaadh.com,https://www.ekaadh.com
# Production boot fails if this is * .
CORS_ALLOWED_ORIGINS=*

# Firebase Cloud Messaging (push). Project: ekaadh-71c90
# Place service account JSON at storage/app/firebase-credentials.json (gitignored).
FCM_ENABLED=false
FCM_PROJECT_ID=ekaadh-71c90
FCM_CREDENTIALS=

# Sanctum personal access token lifetime (minutes). Default 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

ZAAD_ENABLED=false
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
ZAAD_API_URL=

EDAHAB_ENABLED=false
EDAHAB_MERCHANT_ID=
EDAHAB_API_KEY=
EDAHAB_API_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@ekaadh.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
